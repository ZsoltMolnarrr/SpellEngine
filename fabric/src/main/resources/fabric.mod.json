{
  "schemaVersion": 1,
  "id": "spell_engine",
  "version": "${version}",
  "name": "Spell Engine",
  "description": "Data driven magic library.",
  "authors": [
    "Daedelus"
  ],
  "contact": {
    "repo": "https://github.com/ZsoltMolnarrr/SpellEngine",
    "issues": "https://github.com/ZsoltMolnarrr/SpellEngine/issues"
  },
  "license": "GPL-3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.spell_engine.fabric.client.FabricClientMod"
    ],
    "main": [
      "net.spell_engine.fabric.FabricMod"
    ],
    "fabric-datagen": [
      "net.spell_engine.fabric.datagen.SpellEngineDataGenerator"
    ],
    "fabric-model-loading-plugin": [
      "net.spell_engine.fabric.client.FabricModelDiscovery"
    ],
    "modmenu": [
      "net.spell_engine.fabric.client.compat.ModMenuCompatibility"
    ],
    "dynamiclights": [
      "net.spell_engine.fabric.client.compat.DynamicLightsCompatibility"
    ]
  },
  "mixins": [
    "spell_engine.mixins.json",
    "spell_engine-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabricloader": ">=0.15.0",
    "fabric-api": ">=0.92.0",
    "cloth-config": ">=11.1.106",
    "player-animator": ">=1.0.2",
    "spell_power": ">=1.6.0"
  },
  "recommends": {
    "trinkets": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/KN9b3pjFTM"
      }
    }
  }
}
